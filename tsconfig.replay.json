{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "CommonJS",
		"moduleResolution": "Node",
		"outDir": ".replay",
		"rootDir": ".",
		"types": ["node"],
		"declaration": false,
		"declarationMap": false,
		"importHelpers": false,
		"isolatedModules": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"tsBuildInfoFile": ".replay/.tsbuildinfo"
	},
	"include": ["src", "scripts", "tests/helpers"],
	"exclude": ["node_modules", "dist", ".replay"]
}
